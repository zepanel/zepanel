#!/usr/bin/env bash
# zpanel-uninstaller — zPanel'i ve kurulumun sunucuya koyduğu HER ŞEYİ kaldırır; sunucuyu kurulum öncesi haline döndürür.
#
# Kullanım (root):
#   bash zpanel-uninstaller            silinecekleri listeler, yazılı onay ister, sonra temizler
#   bash zpanel-uninstaller --kuru     yalnız listeler (paket bağımlılık denetimi dahil); hiçbir şey silmez
#   bash zpanel-uninstaller --evet     onay sormaz (otomasyon; silinecekler yine yazdırılır)
#
# Silinenler:
#   - Kurulumdan SONRA sunucuya eklenen TÜM paketler (bağımlılıklar dahil). Liste, kurulumun başında saklanan
#     /var/lib/zpanel-baseline/paketler-oncesi.txt dosyasından çıkarılır: "şu an kurulu olanlar - kurulumdan önce kurulu olanlar".
#   - zPanel servisleri, veritabanları (PostgreSQL ve MariaDB), posta kutuları, müşteri siteleri, panelin kendi sertifikaları (/etc/zpanel/tls),
#     yapılandırma dosyaları ve bunların sistem hesapları.
# Silinmeyenler: yedekler (/var/backups/zpanel ile eski kökler /var/zpanel/backups, /var/zpanel-backups; varsayılan olarak KORUNUR, istenirse elle silinir),
#   Let's Encrypt klasörü (/etc/letsencrypt; yalnız zPanel'in kendi iki certbot kanca dosyası silinir), kurulumdan önce zaten kurulu olan paketler, güvenlik duvarı ve SELinux ayarları, korunan sistem paketleri
#   (pam, systemd, openssl, curl, tar, rpm/dnf/apt, sudo, openssh, çekirdek ... listede "korunan" olarak gösterilir).
# Eski sürümle yapılmış kurulumlarda kayıt yoktur; o zaman kurulumun başladığı andan (install-started) sonra eklenen paketler
#   (rpm kurulum zamanı / dpkg günlüğü) kaldırılır; iz de yoksa yalnız bilinen zPanel paketleri.
#
# Güvenlik: sunucuda zPanel izi yoksa (/opt/zpanel, /etc/zpanel, /var/lib/zpanel, zpanel hesabı) hiçbir şey yapmaz.
# Bu işlem GERİ ALINAMAZ. Önce gerekli verileri başka yere yedekleyin.
set -Eeuo pipefail
# rpm/apt çıktıları ayrıştırılıyor ("Failed dependencies" vb.): sunucu Türkçe/başka dilde olsa da aynı metni versin.
export LC_ALL=C LANG=C

ROOT_PREFIX=${ZPANEL_UNINSTALL_ROOT:-}   # yalnız sınama için: dosya yolları bu önekle çalışır; paket/servis/hesap adımları atlanır
BASELINE_DIR=${ZPANEL_BASELINE_DIR:-/var/lib/zpanel-baseline}
DRY=0
YES=0
for arg in "$@"; do
  case "$arg" in
    --kuru) DRY=1 ;;
    --evet) YES=1 ;;
    --yardim|-h|--help) sed -n "2,22p" "$0" | sed 's/^# \{0,1\}//'; exit 0 ;;
    *) echo "Bilinmeyen parametre: $arg (kullanım: --kuru, --evet)" >&2; exit 2 ;;
  esac
done

die() { echo "HATA: $*" >&2; exit 1; }

# Betik /opt/zpanel içinden çalıştırılırsa kendi dosyası silinir; geçici bir kopyadan yeniden başlat.
if [[ -z $ROOT_PREFIX && $(readlink -f -- "$0") == /opt/zpanel/* ]]; then
  copy=$(mktemp /tmp/zpanel-uninstaller.XXXXXX)
  cp -- "$0" "$copy"
  exec bash "$copy" "$@"
fi

[[ $EUID == 0 || -n $ROOT_PREFIX ]] || die 'Root yetkisi gerekir (sudo bash zpanel-uninstaller).'
p() { printf '%s%s' "$ROOT_PREFIX" "$1"; }

FAMILY=other
if [[ -r /etc/os-release ]]; then
  # shellcheck disable=SC1091
  . /etc/os-release
  case " ${ID:-} ${ID_LIKE:-} " in
    *" debian "*|*" ubuntu "*) FAMILY=debian ;;
    *" rhel "*|*" fedora "*|*" almalinux "*|*" centos "*) FAMILY=rhel ;;
  esac
fi

# ---- tanımlar ----
UNITS=(zpanel-cert-renew.timer zpanel-cert-renew.service zpanel-installer zpanel-worker zpanel-api zpanel-agent zpanel-rootauth.socket
  lshttpd lsws openlitespeed nginx httpd apache2 named bind9 mariadb mysql redis redis-server postgresql postgresql-17 postfix dovecot pure-ftpd fail2ban)
# Eski kurulumlar için (kayıt yoksa) bilinen zPanel paketleri:
RPM_KNOWN=(openlitespeed 'lsphp*' 'postgresql17*' 'mariadb*' redis httpd 'httpd-*' mod_http2 'nginx*' postfix dovecot bind pure-ftpd 'fail2ban*' certbot 'python3-certbot*')
DEB_KNOWN=(openlitespeed 'lsphp*' 'postgresql*' 'mariadb-*' redis-server 'apache2*' 'nginx*' postfix 'dovecot-*' bind9 'pure-ftpd*' fail2ban certbot 'python3-certbot*')
# Hangi durumda olursa olsun kaldırılmayacak sistem paketleri (sunucuyu bozar):
PROTECTED_RE='^(pam|pam-.*|systemd|systemd-.*|glibc|glibc-.*|libc6|bash|coreutils|coreutils-.*|openssl|openssl-libs|libssl.*|openssh.*|curl|libcurl.*|tar|rpm|rpm-.*|dnf|dnf-.*|yum|apt|apt-.*|dpkg|sudo|shadow-utils|login|passwd|util-linux.*|kernel.*|linux-image.*|linux-base|grub.*|NetworkManager.*|netplan.*|firewalld.*|ufw|iptables.*|nftables.*|selinux-policy.*|libselinux.*|libsemanage.*|policycoreutils.*|sssd.*|cloud-init.*|ca-certificates|platform-python.*|python3-dnf.*|python3-rpm|python3-libs|python3-hawkey|python3-libdnf|dbus.*|sed|grep|gawk|findutils|filesystem|setup|basesystem|bind-libs.*|bind-license|bind-utils|python3-bind)$'
# KORUNAN yedek kökleri: hiçbir koşulda silinmez (kaldırma bunlara dokunmaz; /var/zpanel silinirken backups alt klasörü atlanır).
PRESERVE=(/var/backups/zpanel /var/zpanel/backups /var/zpanel-backups)
# /var/zpanel eski kurulumların kökü: backups hariç içeriği silinir (clean_var_zpanel); PATHS'te YOKTUR.
PATHS=(/opt/zpanel /etc/zpanel /var/lib/zpanel /var/log/zpanel /usr/libexec/zpanel
  /usr/local/lsws /var/lib/pgsql /var/lib/postgresql /etc/postgresql /var/lib/mysql /etc/my.cnf.d/99-zpanel.cnf /etc/mysql/mariadb.conf.d/99-zpanel.cnf
  /var/lib/redis /var/www/vhosts /var/www/zpanel-acme /var/www/roundcube /var/lib/roundcube /var/vmail
  /etc/postfix /var/spool/postfix /etc/dovecot /var/lib/dovecot /etc/pure-ftpd /etc/httpd /var/log/httpd /etc/apache2 /var/named /etc/named /etc/named.conf /etc/bind /var/lib/bind
  /etc/letsencrypt/renewal-hooks/deploy/zpanel /etc/letsencrypt/renewal-hooks/deploy/zpanel-reload /var/lib/letsencrypt /etc/logrotate.d/zpanel /etc/pam.d/zpanel
  /etc/systemd/system/zpanel-installer.service.d /etc/yum.repos.d/zpanel-litespeed.repo /etc/pki/rpm-gpg/RPM-GPG-KEY-zpanel-litespeed)
GLOBS=(/etc/systemd/system/zpanel-* /etc/fail2ban/jail.d/zpanel* /etc/fail2ban/filter.d/zpanel* /etc/fail2ban/action.d/zpanel*)
ACCOUNTS=(zpanel vmail)

for path in "${PATHS[@]}" "${PRESERVE[@]}"; do
  case "$path" in
    /|/etc|/var|/usr|/opt|/home|/root|/bin|/sbin|/lib|/lib64|/boot|/dev|/proc|/sys|/run|/tmp|'') die "Güvensiz silme yolu tanımı: '$path'" ;;
    /*) ;;
    *) die "Göreli silme yolu tanımı: '$path'" ;;
  esac
done

# ---- paket kümeleri ----
installed_names() {
  if [[ -n ${ZPANEL_UNINSTALL_INSTALLED_LIST:-} ]]; then sort -u "$ZPANEL_UNINSTALL_INSTALLED_LIST"; return; fi
  if [[ $FAMILY == rhel ]]; then rpm -qa --qf '%{NAME}\n' 2>/dev/null | sort -u
  elif [[ $FAMILY == debian ]]; then dpkg-query -W -f='${Package}\n' 2>/dev/null | sort -u; fi
}

# Kurulum öncesi kaydı olmayan (eski sürümle yapılmış) kurulumlar için: kurulumun başladığı andan (install-started) sonra
# sunucuya YENİ eklenen paketler. AlmaLinux: rpm kurulum zamanı; Ubuntu/Debian: dpkg günlüğündeki "install" satırları.
# Not: bu anda yükseltilen eski paketler de görünebilir; korunan sistem paketleri ve bağımlılık denetimi bunları engeller.
history_names() {
  if [[ -n ${ZPANEL_UNINSTALL_HISTORY_LIST:-} ]]; then sort -u "$ZPANEL_UNINSTALL_HISTORY_LIST"; return 0; fi
  local marker t0
  marker=$(p /var/lib/zpanel/install-started)
  [[ -e $marker ]] || return 1
  t0=$(stat -c %W -- "$marker" 2>/dev/null || true)
  [[ $t0 =~ ^[0-9]+$ && $t0 -gt 0 ]] || t0=$(stat -c %Y -- "$marker" 2>/dev/null || true)
  [[ $t0 =~ ^[0-9]+$ ]] || return 1
  t0=$((t0 - 120))
  if [[ $FAMILY == rhel ]]; then
    rpm -qa --qf '%{NAME}\t%{INSTALLTIME}\n' 2>/dev/null | awk -F'\t' -v t="$t0" '$2 >= t {print $1}' | sort -u
  elif [[ $FAMILY == debian ]]; then
    local start
    start=$(date -d "@$t0" '+%Y-%m-%d %H:%M:%S')
    { zcat -f /var/log/dpkg.log* 2>/dev/null || true; } | awk -v s="$start" '$3 == "install" && ($1 " " $2) >= s {print $4}' | sed 's/:.*//' | sort -u \
      | comm -12 - <(installed_names)
  else
    return 1
  fi
}

# Çıktı: SOURCE=kayit|bilinen satırı, sonra "remove <ad>" ve "keep <ad>" satırları.
package_plan() {
  local now baseline
  now=$(mktemp); baseline=$(mktemp)
  installed_names > "$now"
  if [[ -s $BASELINE_DIR/paketler-oncesi.txt ]]; then
    echo 'source kayit'
    sort -u "$BASELINE_DIR/paketler-oncesi.txt" > "$baseline"
    comm -23 "$now" "$baseline" > "$baseline.fark"
  elif history_names > "$baseline.gecmis" 2>/dev/null && [[ -s $baseline.gecmis ]]; then
    echo 'source gecmis'
    { cat "$baseline.gecmis"; while read -r name; do case "$name" in zpanel*) echo "$name" ;; esac; done < "$now"; } | sort -u > "$baseline.fark"
  else
    echo 'source bilinen'
    : > "$baseline.fark"
    local pats=("${RPM_KNOWN[@]}") pat
    [[ $FAMILY == debian ]] && pats=("${DEB_KNOWN[@]}")
    for pat in "${pats[@]}" 'zpanel*'; do
      # shellcheck disable=SC2254
      while read -r name; do case "$name" in $pat) echo "$name" >> "$baseline.fark" ;; esac; done < "$now"
    done
    sort -u "$baseline.fark" -o "$baseline.fark"
  fi
  while read -r name; do
    [[ -n $name ]] || continue
    if [[ $name =~ $PROTECTED_RE ]]; then echo "keep $name"; else echo "remove $name"; fi
  done < "$baseline.fark"
  rm -f "$now" "$baseline" "$baseline.fark" "$baseline.gecmis"
}

# rpm: bağımlılık denetiminde başka paketlerin ihtiyaç duyduğu paketleri kümeden çıkarır (başkasının bağımlılığı bozulmasın).
# Çıktı: kalan küme (stdout) ve korunan paketler (stderr: "blocked <ad>").
rpm_safe_set() {
  local -a set=("$@") next
  local round out cap name
  for round in $(seq 1 25); do
    ((${#set[@]})) || break
    out=$(rpm -e --test "${set[@]}" 2>&1 || true)
    if ! grep -q 'Failed dependencies' <<< "$out"; then printf '%s\n' "${set[@]}"; return 0; fi
    local -A drop=()
    while read -r cap; do
      [[ -n $cap ]] || continue
      while read -r name; do [[ -n $name ]] && drop["$name"]=1; done < <(rpm -q --whatprovides --qf '%{NAME}\n' "$cap" 2>/dev/null | grep -v 'no package provides' || true)
    done < <(sed -n 's/^[[:space:]]*\(.*\) is needed by.*/\1/p' <<< "$out")
    next=()
    for name in "${set[@]}"; do
      if [[ -n ${drop[$name]:-} ]]; then echo "blocked $name" >&2; else next+=("$name"); fi
    done
    ((${#next[@]} != ${#set[@]})) || { printf '%s\n' "${set[@]}"; return 0; }   # ilerleme yok: olduğu gibi bırak
    set=("${next[@]}")
    unset drop
  done
  printf '%s\n' "${set[@]}"
}

# ---- zPanel izi var mı? ----
trace=()
for path in /opt/zpanel /etc/zpanel /var/lib/zpanel; do [[ -e $(p "$path") ]] && trace+=("$path"); done
if [[ -z $ROOT_PREFIX ]]; then
  getent passwd zpanel >/dev/null 2>&1 && trace+=('zpanel hesabı')
  for unit in zpanel-api zpanel-agent; do systemctl cat "$unit" >/dev/null 2>&1 && trace+=("$unit servisi"); done
fi
if ((${#trace[@]} == 0)); then
  echo 'Bu sunucuda zPanel izi bulunamadı (/opt/zpanel, /etc/zpanel, /var/lib/zpanel, zpanel hesabı yok). Yapılacak bir şey yok; hiçbir şey silinmedi.'
  exit 0
fi

# ---- özet ----
size_of() { du -sh -- "$1" 2>/dev/null | awk '{print $1}'; }
echo '=============================================================='
echo ' zPanel TAM TEMİZLİK (SIFIRDAN) — GERİ ALINAMAZ'
echo '=============================================================='
echo "Bulunan zPanel izleri: ${trace[*]}"
echo
for path in "${PRESERVE[@]}"; do
  real=$(p "$path")
  if [[ -e $real ]]; then printf 'KORUNAN: %-30s %s (silinmez; gerekirse elle silin)\n' "$path" "$(size_of "$real")"
  else printf 'KORUNAN: %-30s (şu an yok; yedek kökü, silinmez)\n' "$path"; fi
done
echo "KORUNAN: /etc/letsencrypt (Let's Encrypt sertifikaları ve hesap; silinmez)"
echo 'Silinecek dizin ve dosyalar (var olanlar, boyutlarıyla):'
real=$(p /var/zpanel)
if [[ -d $real && ! -L $real ]]; then printf '  %-48s %s\n' '/var/zpanel (backups hariç)' "$(du -sh --exclude=backups -- "$real" 2>/dev/null | awk '{print $1}')"; fi
for path in "${PATHS[@]}"; do
  real=$(p "$path")
  if [[ -e $real || -L $real ]]; then printf '  %-48s %s\n' "$path" "$(size_of "$real")"; fi
done
for glob in "${GLOBS[@]}"; do
  for real in $(p "$glob"); do [[ -e $real ]] && printf '  %-48s\n' "${real#"$ROOT_PREFIX"}"; done
done 2>/dev/null || true

REMOVE=(); KEEP=(); SOURCE=bilinen
if [[ -z $ROOT_PREFIX || -n ${ZPANEL_UNINSTALL_INSTALLED_LIST:-} ]]; then
  while read -r kind name; do
    case "$kind" in
      source) SOURCE=$name ;;
      remove) REMOVE+=("$name") ;;
      keep) KEEP+=("$name") ;;
    esac
  done < <(package_plan)
  echo
  case "$SOURCE" in
    kayit) echo "Kaldırılacak paketler: ${#REMOVE[@]} (kurulumdan sonra eklenenlerin tamamı; kayıt: $BASELINE_DIR/paketler-oncesi.txt):" ;;
    gecmis) echo "Kaldırılacak paketler: ${#REMOVE[@]} (kurulum öncesi kayıt yok — eski kurulum; kurulumun başladığı andan sonra eklenenler, TAHMİNİ: listeyi kontrol edin):" ;;
    *) echo "Kaldırılacak paketler: ${#REMOVE[@]} (kurulum öncesi kayıt ve kurulum izi yok; yalnız bilinen zPanel paketleri):" ;;
  esac
  ((${#REMOVE[@]})) && printf '%s ' "${REMOVE[@]}" | fold -s -w 100 | sed 's/^/  /'
  echo
  if ((${#KEEP[@]})); then echo "Korunan sistem paketleri (kaldırılmaz): ${KEEP[*]}"; fi
  if [[ -z $ROOT_PREFIX ]]; then
    echo
    echo 'Servisler:'
    for unit in "${UNITS[@]}"; do systemctl cat "$unit" >/dev/null 2>&1 && printf '  %s' "$unit"; done; echo
    echo 'Silinecek sistem hesapları:'
    for acct in "${ACCOUNTS[@]}"; do getent passwd "$acct" >/dev/null 2>&1 && printf '  %s' "$acct"; done
    getent passwd | awk -F: '$6 ~ "^/var/www/vhosts/" {printf "  %s(müşteri sitesi)", $1}'; echo
  fi
fi

SAFE=("${REMOVE[@]}")
if [[ -z $ROOT_PREFIX && $FAMILY == rhel && ${#REMOVE[@]} -gt 0 ]]; then
  echo
  echo 'Bağımlılık denetimi (rpm -e --test; hiçbir şey silinmez)...'
  mapfile -t SAFE < <(rpm_safe_set "${REMOVE[@]}" 2> "$BASELINE_DIR.blocked" || true)
  if [[ -s $BASELINE_DIR.blocked ]]; then
    echo "  Başka paketlerin ihtiyaç duyduğu ve bu yüzden KORUNACAK paketler: $(sed 's/^blocked //' "$BASELINE_DIR.blocked" | sort -u | tr '\n' ' ')"
  else
    echo '  Sorun yok: kaldırma başka bir paketin bağımlılığını bozmaz.'
  fi
  rm -f "$BASELINE_DIR.blocked"
fi

echo
echo 'DİKKAT: veritabanları, posta kutuları ve müşteri siteleri DAHİL her şey silinir; KORUNAN yedek klasörleri ve /etc/letsencrypt silinmez.'
echo 'Silinmeyenler: kurulumdan önce kurulu paketler, güvenlik duvarı ve SELinux ayarları.'

if ((DRY)); then
  echo; echo '(--kuru: hiçbir şey silinmedi.)'
  exit 0
fi

# ---- onay ----
if ((!YES)); then
  if [[ -t 0 ]]; then tty_in=/dev/stdin
  elif { : < /dev/tty; } 2>/dev/null; then tty_in=/dev/tty   # curl ... | bash ile çalıştırıldığında terminalden oku
  else die 'Onay gerekir: etkileşimli terminalde çalıştırın ya da --evet ekleyin.'; fi
  read -r -p $'\nDevam etmek için TAM TEMIZLIK yazın: ' answer < "$tty_in" || die 'Onay okunamadı.'
  [[ $answer == 'TAM TEMIZLIK' ]] || die 'Vazgeçildi; hiçbir şey silinmedi.'
fi

# ---- temizlik ----
warn=0
step() {
  if "$@" >/dev/null 2>&1; then return 0; fi
  warn=$((warn + 1)); printf 'UYARI: tamamlanamadı: %s\n' "$*" >&2
}

if [[ -z $ROOT_PREFIX ]]; then
  echo '-> Servisler durduruluyor...'
  for unit in "${UNITS[@]}"; do
    if systemctl cat "$unit" >/dev/null 2>&1; then step systemctl disable --now "$unit"; fi
  done
  pkill -u zpanel 2>/dev/null || true

  echo "-> Paketler kaldırılıyor (${#SAFE[@]})..."
  if ((${#SAFE[@]})); then
    if [[ $FAMILY == rhel ]]; then
      step rpm -e "${SAFE[@]}"
      # Bir paketin kaldırma betiği (%preun) hata verirse rpm hepsini bırakmaz; kalanlar betiksiz silinir (veriler zaten temizlenecek).
      left=()
      for name in "${SAFE[@]}"; do rpm -q "$name" >/dev/null 2>&1 && left+=("$name"); done
      if ((${#left[@]})); then
        echo "   kaldırma betiği hata verdi, betiksiz yeniden deneniyor: ${left[*]}"
        step rpm -e --noscripts "${left[@]}"
      fi
    elif [[ $FAMILY == debian ]]; then
      sim=$(apt-get -s purge "${SAFE[@]}" 2>/dev/null | awk '/^Purg|^Remv/ {print $2}' | sort -u)
      extra=$(comm -13 <(printf '%s\n' "${SAFE[@]}" | sort -u) <(printf '%s\n' "$sim") | tr '\n' ' ')
      if [[ -n ${extra// /} ]]; then
        echo "UYARI: apt bu paketleri de kaldırmak istiyor (kurulumdan önce vardı); paket kaldırma ATLANDI: $extra" >&2
        warn=$((warn + 1))
      else
        step apt-get purge -y "${SAFE[@]}"
      fi
    else
      echo 'UYARI: işletim sistemi ailesi tanınmadı; paketler elle kaldırılmalı.' >&2
    fi
  fi
  # AlmaLinux 8: kurulumun açtığı dnf modül akışlarını sıfırla (en iyi çaba).
  if [[ $FAMILY == rhel ]] && command -v dnf >/dev/null 2>&1; then
    step dnf module reset -y postgresql mariadb httpd nginx redis perl perl-DBI perl-DBD-MySQL perl-IO-Socket-SSL perl-libwww-perl php
  fi

  echo '-> Sistem hesapları siliniyor...'
  while read -r acct; do [[ -n $acct ]] && step userdel "$acct"; done < <(getent passwd | awk -F: '$6 ~ "^/var/www/vhosts/" {print $1}')
  for acct in "${ACCOUNTS[@]}"; do getent passwd "$acct" >/dev/null 2>&1 && step userdel "$acct"; getent group "$acct" >/dev/null 2>&1 && step groupdel "$acct"; done
fi

echo '-> Dosyalar ve veriler siliniyor...'
clean_var_zpanel() {
  local real; real=$(p /var/zpanel)
  [[ -d $real && ! -L $real ]] || return 0
  find "$real" -mindepth 1 -maxdepth 1 ! -name backups -exec rm -rf -- {} +
  rmdir -- "$real" 2>/dev/null || true   # backups varsa dizin kalır
}
step clean_var_zpanel
for path in "${PATHS[@]}"; do
  real=$(p "$path")
  if [[ -e $real || -L $real ]]; then step rm -rf -- "$real"; fi
done
for glob in "${GLOBS[@]}"; do
  for real in $(p "$glob"); do if [[ -e $real || -L $real ]]; then step rm -rf -- "$real"; fi; done
done 2>/dev/null || true
if [[ -z $ROOT_PREFIX ]]; then step systemctl daemon-reload; step systemctl reset-failed; fi

# ---- doğrulama ----
left=()
for path in /opt/zpanel /etc/zpanel /var/lib/zpanel /usr/local/lsws /var/lib/pgsql /var/lib/postgresql /var/lib/mysql /var/www/vhosts; do
  [[ -e $(p "$path") ]] && left+=("$path")
done
if [[ -z $ROOT_PREFIX ]]; then
  getent passwd zpanel >/dev/null 2>&1 && left+=('zpanel hesabı')
  if ((${#SAFE[@]})); then
    still=$(comm -12 <(printf '%s\n' "${SAFE[@]}" | sort -u) <(installed_names) | tr '\n' ' ')
    [[ -z ${still// /} ]] || left+=("paket: $still")
  fi
fi
echo
if ((${#left[@]})); then
  echo "UYARI: temizlik tamamlanamadı; kalanlar: ${left[*]}" >&2
  echo 'Elle silmeyi deneyin ya da sunucuyu yeniden kurun. (Kurulum öncesi paket kaydı korundu.)' >&2
  exit 1
fi
# Kayıt yalnız her şey temizlenince silinir; böylece yeniden kurulumda yeni bir başlangıç kaydı alınır.
rm -rf -- "$BASELINE_DIR"
((warn == 0)) || echo "Temizlik bitti; $warn adımda uyarı vardı (yukarıya bakın)."
echo 'zPanel ve kurulumun koyduğu her şey kaldırıldı. Sunucu kurulum öncesi haline döndü; yeniden kurulabilir.'
echo 'Not: güvenlik duvarı ve SELinux ayarlarına dokunulmadı.'
